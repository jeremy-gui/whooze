{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "strict": false,
    "ignoreDeprecations": "6.0",
    "sourceMap": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "preserve",
    "moduleResolution": "bundler",
    "importHelpers": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ]
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true
  }
}
